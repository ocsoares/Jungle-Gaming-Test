{
  "extends": "../../../packages/tsconfig/base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "emitDeclarationOnly": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@repo/contracts": ["../../../packages/contracts/dist/index"],
      "@repo/contracts/*": ["../../../packages/contracts/dist/*"],
    }
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}